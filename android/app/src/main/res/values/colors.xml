<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#7C3AED</color>
    <!-- Tint colour applied by Android to the monochrome notification status
         icon (ic_stat_logo) and the small accent strip in the expanded view. -->
    <color name="notification_accent">#7C3AED</color>
    <!-- Native splash backdrop — black. The OS-level splash hands off to
         the Flutter splash quickly, and black avoids the bright purple
         flash on cold-launch. -->
    <color name="splash_background">#000000</color>
</resources>