<?xml version="1.0" encoding="utf-8"?>
<!--
    Native Android launch screen. Shown by the OS between process start and
    Flutter's first frame. Matches the Flutter splash (violet background +
    white running character) so the handoff is seamless instead of a
    black-flash → purple-pop.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
