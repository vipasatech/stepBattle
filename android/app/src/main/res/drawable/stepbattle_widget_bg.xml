<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card background for the StepBattle widget. Matches the in-app
     surface palette (#1A1A1C) with a violet glow border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1A1A1C" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#7C3AED" />
</shape>
