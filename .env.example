# Copy this file to .env (gitignored) and fill in your project values.
# Supabase values are safe to expose in client code — security is enforced
# server-side by Row Level Security policies on each table. Observability
# secrets ARE sensitive; do not commit real values.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Observability ─────────────────────────────────────────────────────
# Both keys default to `changeme` in local dev — the SDKs no-op cleanly
# when unset, so the app boots without a Sentry / PostHog account. Get
# real values from the respective project dashboards for staging + prod.
#
# Sentry: https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=changeme
# Environment tag attached to every event (dev / staging / production).
SENTRY_ENV=dev
# 0.0–1.0. 1.0 = every session; drop to 0.1 in prod to stay under the
# free tier's 5k session/month cap.
SENTRY_TRACES_SAMPLE_RATE=1.0

# PostHog: Project Settings → API keys → Project API Key.
POSTHOG_API_KEY=changeme
# Cloud region host. EU: https://eu.i.posthog.com, US: https://us.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# ── Payment gateway ───────────────────────────────────────────────────
# Which payment gateway the Buy XP flow uses. See
# lib/providers/payment_provider_provider.dart for details.
#   * razorpay (default): India-native, ~2% MDR, native UPI. INR-only.
#     Requires an Indian merchant account.
#   * stripe: Global multi-currency (INR + USD + EUR + GBP + AUD).
#     Requires Stripe account + secrets set in Supabase Edge Function
#     secrets (STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY,
#     STRIPE_WEBHOOK_SECRET). See PENDING_MIGRATIONS.md for the
#     deployment checklist.
PAYMENT_PROVIDER=razorpay
