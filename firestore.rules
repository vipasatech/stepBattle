rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // USERS
    //
    // Read: any authenticated user (needed for friend search, leaderboards).
    // Write: only the owner of the doc.
    //
    // We previously had an `affectedKeys` check to block clients from
    // self-bumping `totalXP`, `level`, etc. — but the Firestore rule
    // engine's behavior with `set(merge: true)` made it brittle for the
    // geo-home write. For MVP we trust authenticated users; once we have
    // Cloud Functions on Blaze, server-side validation will replace this.
    // =========================================================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // STEP LOGS
    //
    // The `resource == null` branch handles `get()` on a not-yet-created
    // doc (Firestore evaluates rules even when the doc is missing —
    // `resource.data.x` against a null `resource` denies, which broke the
    // "read existing → compute delta" path in StepService).
    //
    // The `resource.data.userId == request.auth.uid` branch handles both
    // single-doc reads of existing docs AND collection queries: Firestore's
    // query rule-prover satisfies it via the `where('userId', '==', uid)`
    // constraint that StepService.getStepHistory and friends always include.
    // =========================================================================
    match /step_logs/{logId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // BATTLES
    // =========================================================================
    match /battles/{battleId} {
      // Participants can read any battle they're in
      allow read: if request.auth != null;
      // Authenticated users can create battles
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      // Participants can update (step counts, accept)
      allow update: if request.auth != null;
      // Only creator can delete (cancel pending)
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'pending';
    }

    // =========================================================================
    // MISSIONS (read-only for clients, admin-written)
    // =========================================================================
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions / admin
    }

    // =========================================================================
    // USER MISSION PROGRESS
    //
    // `resource == null` allows the `_upsertProgress` pre-read on a doc that
    // hasn't been written yet today. The userId branch covers existing-doc
    // reads AND the `watchDailyProgress` / `watchWeeklyProgress` streams,
    // which both filter on `where('userId', '==', uid)`.
    // =========================================================================
    match /user_mission_progress/{progressId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // CLANS
    // =========================================================================
    match /clans/{clanId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow delete: if request.auth != null
        && resource.data.captainId == request.auth.uid;

      // Clan members subcollection
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/clans/$(clanId)).data.memberIds;
      }
    }

    // =========================================================================
    // CLAN BATTLES
    // =========================================================================
    match /clan_battles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // =========================================================================
    // FRIEND RELATIONSHIPS
    //
    // Source of truth for friendships. We do NOT mirror to users.friends[]
    // anymore — the users rule disallows cross-user writes, which broke the
    // accept flow. Friend lists are derived client-side from this collection
    // (see lib/providers/friend_provider.dart).
    //
    // Lifecycle:
    //   • from-user creates  → status: 'pending'
    //   • to-user updates    → status: 'accepted' | 'rejected'
    //   • either party deletes → unfriends / cancels (the doc disappearing
    //                              is the unfriend signal that the live
    //                              streams pick up)
    // =========================================================================
    match /friend_relationships/{relationshipId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      // Only the recipient can flip status (accept/reject). The sender
      // unfriends/cancels via delete instead.
      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid;
      // Either party can delete: sender cancels outgoing pending request,
      // either party unfriends an accepted relationship.
      allow delete: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
    }

    // =========================================================================
    // NOTIFICATIONS
    //
    // Spark-plan architecture: there are no Cloud Functions. Battle, friend,
    // and clan services all write notifications client-side from the actor's
    // device (e.g., when User A sends User B a friend request, A's app
    // creates a notification doc with userId = B). So creates must be open
    // to authenticated clients. Reads/updates remain owner-only.
    // =========================================================================
    match /notifications/{notificationId} {
      // A user can read only notifications addressed to them.
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Authenticated users can create notifications targeting any user.
      // Required shape: a `userId` string field (the recipient). The
      // `data.fromUserId` field, when present, must match the caller —
      // prevents impersonation in deep-link payloads.
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && (
          !('fromUserId' in request.resource.data.data)
          || request.resource.data.data.fromUserId == request.auth.uid
        );

      // Recipient can mark as read; nobody else can update.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // No client-side delete (analytics retention).
      allow delete: if false;
    }

    // =========================================================================
    // LEADERBOARD SNAPSHOTS (read-only, written by Cloud Functions)
    // =========================================================================
    match /leaderboard_snapshots/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions
    }

    // =========================================================================
    // SOURCE STEP HOURLY  (per-source step breakdown, hourly buckets)
    // Doc id format: {userId}_{yyyy-MM-dd-HH UTC}
    // Required composite index:
    //   collection: source_step_hourly
    //   fields: userId asc, hourStart desc
    // =========================================================================
    match /source_step_hourly/{logId} {
      // Allow get() on missing docs AND queries with where('userId','==',uid).
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      // A user can create / upsert their own logs.
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // No client-side deletion (analytics retention is handled server-side).
      allow delete: if false;
    }
  }
}
